import "./style.css";
import { redirect } from "@elements/app";
import { signup, MIN_PASSWORD, SignupForm, InviteInfo } from "#app/shared/services/auth";
import { Alert } from "@elements/ui/alert";
import { Button } from "@elements/ui/button";
import { Field } from "@elements/ui/field";
import { Input } from "@elements/ui/input";

function onSubmit(form: SignupForm, busy: { on: boolean }) {
  busy.on = true;

  try {
    signup(form);
    form.error = "";
    redirect("/lists");
  } catch (err: any) {
    form.error = err.message;
    busy.on = false;
  }
}

<html lang="en" class="page-signup" (
  invite: InviteInfo | null,
  expired: boolean,
  private form: SignupForm = {
    name: "",
    email: invite?.email ?? "",
    password: "",
    householdName: "",
    invite: invite?.token ?? "",
    error: "",
  },
  private busy: { on: boolean } = { on: false },
)>
  <head>
    <title>{invite ? `Join ${invite.householdName}` : "Start a household"} · kinroster</title>
  </head>
  <body>
    <main class="auth-shell">
      <div class="auth-grid">
        <div class="auth-intro stack is-lg">
          <div class="auth-brand row">
            <span class="kin-mark">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M3 10.5 12 3l9 7.5"/>
                <path d="M5 9.5V20h14V9.5"/>
                <path d="M10 20v-5.5h4V20"/>
              </svg>
            </span>
            kinroster
          </div>
          <h1 e:if={invite} class="display">{invite!.invitedBy} saved you a spot in {invite!.householdName}.</h1>
          <h1 e:else class="display">Start your household.</h1>
          <p class="lede" e:if={invite}>Make an account and you'll see the family's lists, chores and dinners straight away.</p>
          <p class="lede" e:else>Make an account, name the household, then invite everyone from the Family tab.</p>
        </div>

        <div class="auth-card card">
          <form class="stack" onsubmit={() => onSubmit(form, busy)}>
            <h2>{invite ? "Join the household" : "Create your account"}</h2>

            <Alert e:if={expired} variant="warning" role="none" description="That invitation has been used or revoked. You can still start a household of your own." />
            <Alert e:if={form.error} variant="danger" description={form.error} />

            <Field label="Your name">
              <Input name="name" value={form.name} placeholder="Alex Rivera" required attrs={{ id: "name", autocomplete: "name" }} />
            </Field>

            <Field label="Email">
              <Input type="email"
                     name="email"
                     value={form.email}
                     placeholder="you@example.com"
                     required
                     attrs={{ id: "email", autocomplete: "email", autocapitalize: "none", spellcheck: "false" }} />
            </Field>

            <Field label="Password" description={`At least ${MIN_PASSWORD} characters.`}>
              <Input type="password"
                     name="password"
                     value={form.password}
                     required
                     attrs={{ id: "password", autocomplete: "new-password", minlength: MIN_PASSWORD }} />
            </Field>

            <Field e:if={!invite} label="Household name">
              <Input name="household" value={form.householdName} placeholder="The Parks" required attrs={{ id: "household" }} />
            </Field>

            <Button type="submit" variant="primary" block loading={busy.on}>
              {invite ? `Join ${invite.householdName}` : "Create household"}
            </Button>

            <p class="text-sm">Already have an account? <a href="/signin">Sign in</a></p>
          </form>
        </div>
      </div>
    </main>
  </body>
</html>
