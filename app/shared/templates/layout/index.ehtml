import "./style.css";
import { session, redirect } from "@elements/app";
import { signout } from "#app/shared/services/auth";
import { initials } from "#app/shared/lib/members";

function onSignout() {
  signout();
  redirect("/signin");
}

<Layout (active: string, householdName: string, color: string)>
  <div class="app">
    <header class="kin-header">
      <div class="kin-header-inner row">
        <a class="kin-brand row" href="/lists">
          <span class="kin-mark">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M3 10.5 12 3l9 7.5"/>
              <path d="M5 9.5V20h14V9.5"/>
              <path d="M10 20v-5.5h4V20"/>
            </svg>
          </span>
          <span class="kin-brand-text">
            <span class="kin-wordmark">kinroster</span>
            <span class="kin-household">{householdName}</span>
          </span>
        </a>

        <nav class="kin-nav row" aria-label="Sections">
          <a href="/lists" class={[active === "lists" && "is-active"]}>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M6 6h15l-1.5 8.5a2 2 0 0 1-2 1.5H8.5a2 2 0 0 1-2-1.6L4.2 3H2"/>
              <circle cx="9" cy="20" r="1.4"/>
              <circle cx="18" cy="20" r="1.4"/>
            </svg>
            Groceries
          </a>
          <a href="/chores" class={[active === "chores" && "is-active"]}>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M9 11l3 3 8-8"/>
              <path d="M20 12v7a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h9"/>
            </svg>
            Chores
          </a>
          <a href="/meals" class={[active === "meals" && "is-active"]}>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M7 2v8a2 2 0 0 0 4 0V2"/>
              <path d="M9 10v12"/>
              <path d="M17 22V2c-2.2 1.4-3 4-3 7v4h3"/>
            </svg>
            Meals
          </a>
          <a href="/household" class={[active === "household" && "is-active"]}>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="9" cy="8" r="3.5"/>
              <path d="M2.5 20a6.5 6.5 0 0 1 13 0"/>
              <path d="M16 4.5a3.5 3.5 0 0 1 0 7"/>
              <path d="M18.5 14a6.5 6.5 0 0 1 3 6"/>
            </svg>
            Family
          </a>
        </nav>

        <div class="kin-me row">
          <Avatar name={session.get("userName") ?? ""} {color} />
          <button class="kin-signout is-ghost is-sm" type="button" onclick={() => onSignout()}>Sign out</button>
        </div>
      </div>
    </header>

    <main class="kin-main app-main">
      <slot/>
    </main>
  </div>
</Layout>

<Avatar (name: string, color: string, size: string = "")>
  <span class={["kin-avatar", `is-${color}`, size && `is-${size}`]} title={name}>{initials(name)}</span>
</Avatar>
