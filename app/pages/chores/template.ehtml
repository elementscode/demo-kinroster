import "./style.css";
import { LiveView } from "@elements/app";
import { Layout, MemberAvatar } from "#app/shared/templates/layout";
import { Chore, Completion, Frequency } from "#app/shared/services/chores";
import { Member, firstName, memberById } from "#app/shared/lib/members";
import { isDue, cadence } from "#app/shared/lib/chores";
import { AlertDialog, AlertDialogFooter, AlertDialogCancel, AlertDialogAction } from "@elements/ui/alert-dialog";
import { Alert } from "@elements/ui/alert";
import { Badge } from "@elements/ui/badge";
import { Button } from "@elements/ui/button";
import { Card, CardContent } from "@elements/ui/card";
import { Checkbox } from "@elements/ui/checkbox";
import { Collapsible, CollapsibleTrigger, CollapsibleContent } from "@elements/ui/collapsible";
import { Field } from "@elements/ui/field";
import { Icon } from "@elements/ui/icon";
import { Input } from "@elements/ui/input";
import { Label } from "@elements/ui/label";
import { NativeSelect } from "@elements/ui/native-select";
import { NumberInput } from "@elements/ui/number-input";
import { Progress } from "@elements/ui/progress";
import { Table, TableHead, TableCell } from "@elements/ui/table";
import { Tabs, TabsList, TabsTrigger, TabsContent } from "@elements/ui/tabs";
import { WEEKDAYS, WEEKDAY_NAMES, addDays, weekDays, weekdayIndex, inWeek, dayOfMonth, shortDate, weekLabel } from "#app/shared/lib/dates";

interface Ui {
  day: string;
}

interface ChoreDraft {
  title: string;
  frequency: Frequency;
  weekday: string;
  assigneeId: string;
  points: number | null;
  error: string;
}

interface Score {
  member: Member;
  points: number;
  done: number;
}

function emptyDraft(): ChoreDraft {
  return { title: "", frequency: "daily" as Frequency, weekday: "5", assigneeId: "", points: 1, error: "" };
}

function byCreated(a: Chore, b: Chore): number {
  return new Date(a.createdAt).getTime() - new Date(b.createdAt).getTime();
}

function completionFor(completions: LiveView<Completion>, chore: Chore, day: string): Completion | undefined {
  return completions.find((c) => c.choreId === chore.id && c.day === day);
}

function dueOn(chores: LiveView<Chore>, day: string): Chore[] {
  return chores.filter((c) => isDue(c, weekdayIndex(day))).sort(byCreated);
}

function doneOn(chores: LiveView<Chore>, completions: LiveView<Completion>, day: string): number {
  return dueOn(chores, day).filter((c) => completionFor(completions, c, day)).length;
}

function scores(members: Member[], completions: LiveView<Completion>, week: string): Score[] {
  let thisWeek = completions.filter((c) => inWeek(c.day, week));

  return members
    .map((member) => {
      let mine = thisWeek.filter((c) => c.userId === member.id);

      return { member, points: mine.reduce((sum, c) => sum + c.points, 0), done: mine.length };
    })
    .sort((a, b) => b.points - a.points);
}

function topPoints(board: Score[]): number {
  return Math.max(1, ...board.map((s) => s.points));
}

function onToggle(completions: LiveView<Completion>, chore: Chore, day: string) {
  let done = completionFor(completions, chore, day);

  if (done) {
    completions.delete(done);
    return;
  }

  completions.insert({
    choreId: chore.id,
    userId: chore.assigneeId,
    day,
    points: chore.points,
    createdAt: new Date(),
  });
}

function onAddChore(chores: LiveView<Chore>, draft: ChoreDraft) {
  let title = draft.title.trim();

  if (!title) {
    draft.error = "Give the chore a name.";
    return;
  }

  chores.insert(
    {
      title,
      frequency: draft.frequency,
      weekday: Number(draft.weekday),
      assigneeId: draft.assigneeId || null,
      points: Math.min(20, Math.max(1, Math.round(Number(draft.points) || 1))),
      createdAt: new Date(),
    },
    () => Object.assign(draft, emptyDraft()),
  );
}

function onAssign(chores: LiveView<Chore>, chore: Chore, e: Event) {
  let value = (e.target as HTMLSelectElement).value;

  chores.update({ ...chore, assigneeId: value || null });
}

function onRemoveChore(chores: LiveView<Chore>, chore: Chore) {
  chores.delete(chore);
}

<html lang="en" class="page-chores" (
  householdName: string,
  color: string,
  members: Member[],
  chores: LiveView<Chore>,
  completions: LiveView<Completion>,
  week: string,
  today: string,
  private ui: Ui = { day: inWeek(today, week) ? today : week },
  private draft: ChoreDraft = emptyDraft(),
)>
  <head>
    <title>Chores · kinroster</title>
  </head>
  <body>
    <Layout active="chores" {householdName} {color}>
      <div class="page-shell stack is-xl" style={{ "max-width": "var(--container-4xl)" }}>
        <div class="chores-head row">
          <h1>Chores</h1>
          <nav class="week-nav row" aria-label="Week">
            <Button href={`/chores?week=${addDays(week, -7)}`} variant="ghost" size="sm" icon label="Previous week"><Icon name="chevron-left" /></Button>
            <span class="week-nav-label">{weekLabel(week)}<small>{shortDate(week)} – {shortDate(addDays(week, 6))}</small></span>
            <Button href={`/chores?week=${addDays(week, 7)}`} variant="ghost" size="sm" icon label="Next week"><Icon name="chevron-right" /></Button>
          </nav>
        </div>

        <section class="board" aria-label="Points this week">
          <Leader e:for={score of scores(members, completions, week)}
                  {score}
                  leader={score.points > 0 && score.member.id === scores(members, completions, week)[0].member.id}
                  max={topPoints(scores(members, completions, week))} />
        </section>

        <Tabs value={ui.day} variant="segmented" class="days-tabs">
          <TabsList label="Day">
            <TabsTrigger e:for={day of weekDays(week)}
                         value={day}
                         class={[
                           "day",
                           day === today && "is-today",
                           day <= today && doneOn(chores, completions, day) === dueOn(chores, day).length && "is-complete",
                         ].filter(Boolean).join(" ")}>
              <span class="day-name">{WEEKDAYS[weekdayIndex(day)]}</span>
              <span class="day-num">{dayOfMonth(day)}</span>
              <span class="day-dots">{doneOn(chores, completions, day)}/{dueOn(chores, day).length}</span>
            </TabsTrigger>
          </TabsList>

          <TabsContent e:for={day of weekDays(week)} value={day}>
            <div class="card">
              <div class="today-head row">
                <h2>{day === today ? "Today" : WEEKDAY_NAMES[weekdayIndex(day)]} <span class="text-sm" style={{ color: "var(--ink-soft)", "font-weight": "400" }}>{shortDate(day)}</span></h2>
                <Badge e:if={day > today} variant="secondary">Coming up</Badge>
                <Badge e:elseif={dueOn(chores, day).length > 0 && doneOn(chores, completions, day) === dueOn(chores, day).length} variant="success">All done</Badge>
              </div>
              <ul class="task-list">
                <li e:for={chore of dueOn(chores, day)}>
                  <Label class={["task", completionFor(completions, chore, day) && "is-done"].filter(Boolean).join(" ")}>
                    <Checkbox checked={!!completionFor(completions, chore, day)}
                              disabled={day > today}
                              onCheckedChange={() => onToggle(completions, chore, day)} />
                    <span class="task-title">
                      <span>{chore.title}</span>
                      <small>{cadence(chore, WEEKDAY_NAMES)} · {memberById(members, chore.assigneeId) ? firstName(memberById(members, chore.assigneeId)!.name) : "Anyone"}</small>
                    </span>
                    <MemberAvatar e:if={memberById(members, chore.assigneeId)} name={memberById(members, chore.assigneeId)!.name} color={memberById(members, chore.assigneeId)!.color} />
                    <span class="task-points">+{chore.points}</span>
                  </Label>
                </li>
              </ul>
            </div>
          </TabsContent>
        </Tabs>

        <section class="stack is-sm">
          <h2 class="text-md">The week at a glance</h2>
          <Table label="The week at a glance" class="card">
            <table class="chart">
              <thead>
                <tr>
                  <TableHead><span class="sr-only">Chore</span></TableHead>
                  <TableHead e:for={day of weekDays(week)} align="center" class={day === today ? "is-today" : ""}>{WEEKDAYS[weekdayIndex(day)]}</TableHead>
                </tr>
              </thead>
              <tbody>
                <tr e:for={chore of chores.sort(byCreated)}>
                  <TableHead scope="row">
                    <span class="row">
                      <MemberAvatar e:if={memberById(members, chore.assigneeId)} name={memberById(members, chore.assigneeId)!.name} color={memberById(members, chore.assigneeId)!.color} />
                      {chore.title}
                    </span>
                  </TableHead>
                  <TableCell e:for={day of weekDays(week)} align="center">
                    <Checkbox e:if={isDue(chore, weekdayIndex(day))}
                              checked={!!completionFor(completions, chore, day)}
                              invalid={!completionFor(completions, chore, day) && day < today}
                              disabled={day > today}
                              attrs={{ "aria-label": `${chore.title}, ${WEEKDAY_NAMES[weekdayIndex(day)]}` }}
                              onCheckedChange={() => onToggle(completions, chore, day)} />
                    <span e:else class="cell-off">·</span>
                  </TableCell>
                </tr>
              </tbody>
            </table>
          </Table>
        </section>

        <Card class="manage">
          <Collapsible>
            <CollapsibleTrigger>
              <Button variant="ghost" block class="manage-trigger">
                <Icon name="chevron-right" class="collapsible-chevron is-right" />
                Add or reassign chores
              </Button>
            </CollapsibleTrigger>
            <CollapsibleContent>
              <CardContent class="stack is-lg">
                <form class="chore-form" onsubmit={() => onAddChore(chores, draft)}>
                  <Field label="Chore">
                    <Input value={draft.title} placeholder="Empty the dishwasher" required attrs={{ id: "chore-title" }} />
                  </Field>
                  <Field label="How often">
                    <NativeSelect block value={draft.frequency} attrs={{ id: "chore-frequency" }}>
                      <option value="daily">Daily</option>
                      <option value="weekly">Weekly</option>
                    </NativeSelect>
                  </Field>
                  <Field label="Day">
                    <NativeSelect block value={draft.weekday} disabled={draft.frequency === "daily"} attrs={{ id: "chore-weekday" }}>
                      <option e:for={[i, name] of WEEKDAY_NAMES.entries()} value={`${i}`}>{name}</option>
                    </NativeSelect>
                  </Field>
                  <Field label="Who">
                    <NativeSelect block value={draft.assigneeId} attrs={{ id: "chore-assignee" }}>
                      <option value="">Anyone</option>
                      <option e:for={m of members} value={m.id}>{firstName(m.name)}</option>
                    </NativeSelect>
                  </Field>
                  <Field label="Points">
                    <NumberInput value={draft.points} min={1} max={20} buttons="end" />
                  </Field>
                  <Button variant="primary" type="submit">Add</Button>
                </form>
                <Alert e:if={draft.error} variant="danger" description={draft.error} />

                <ul class="chore-rows">
                  <li e:for={chore of chores.sort(byCreated)} class="chore-row">
                    <span>{chore.title} <small>· {cadence(chore, WEEKDAY_NAMES)} · {chore.points} {chore.points === 1 ? "pt" : "pts"}</small></span>
                    <NativeSelect size="sm"
                                  block
                                  value={chore.assigneeId ?? ""}
                                  attrs={{ "aria-label": `Who does ${chore.title}` }}
                                  onchange={(e) => onAssign(chores, chore, e)}>
                      <option value="">Anyone</option>
                      <option e:for={m of members} value={m.id}>{firstName(m.name)}</option>
                    </NativeSelect>
                    <AlertDialog title={`Remove "${chore.title}" and its history?`} size="sm">
                      <Button slot="trigger" variant="ghost" size="sm" icon label={`Remove ${chore.title}`}><Icon name="x" /></Button>
                      <AlertDialogFooter>
                        <AlertDialogCancel>Cancel</AlertDialogCancel>
                        <AlertDialogAction variant="danger" onclick={() => onRemoveChore(chores, chore)}>Remove</AlertDialogAction>
                      </AlertDialogFooter>
                    </AlertDialog>
                  </li>
                </ul>
              </CardContent>
            </CollapsibleContent>
          </Collapsible>
        </Card>
      </div>
    </Layout>
  </body>
</html>

<Leader (score: Score, leader: boolean, max: number)>
  <div class={["board-card card stack", leader && "is-leader"]}>
    <div class="board-top row">
      <MemberAvatar name={score.member.name} color={score.member.color} size="md" />
      <span class="board-name">{firstName(score.member.name)}<small>{score.done} done</small></span>
    </div>
    <div class="board-points">{score.points} <small>pts</small></div>
    <Progress class="board-bar" size="sm" value={score.points} {max} attrs={{ "aria-label": `${firstName(score.member.name)}'s points` }} />
    <svg e:if={leader} class="board-crown" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-label="Leading this week"><path d="M3 7l4.5 4L12 4l4.5 7L21 7l-2 11H5z"/></svg>
  </div>
</Leader>
