import "./style.css";
import { LiveView, redirect, session } from "@elements/app";
import { Layout } from "#app/shared/templates/layout";
import { GroceryList, GroceryItem } from "#app/shared/services/groceries";
import { AISLES, aisleLabel, guessAisle } from "#app/shared/lib/aisles";
import { firstName } from "#app/shared/lib/members";
import { AlertDialog, AlertDialogFooter, AlertDialogCancel, AlertDialogAction } from "@elements/ui/alert-dialog";
import { Badge } from "@elements/ui/badge";
import { Button } from "@elements/ui/button";
import { Checkbox } from "@elements/ui/checkbox";
import { Empty } from "@elements/ui/empty";
import { Icon } from "@elements/ui/icon";
import { Input } from "@elements/ui/input";
import { Label } from "@elements/ui/label";
import { NativeSelect } from "@elements/ui/native-select";
import { Progress } from "@elements/ui/progress";

interface Draft {
  quantity: string;
  name: string;
  aisle: string;
}

interface NewList {
  open: boolean;
  name: string;
}

/** One aisle's worth of unchecked items, in the order the store walks. */
interface AisleGroup {
  id: string;
  key: string;
  label: string;
  items: GroceryItem[];
}

function byCreated(a: { createdAt: Date }, b: { createdAt: Date }): number {
  return new Date(a.createdAt).getTime() - new Date(b.createdAt).getTime();
}

function toGet(items: LiveView<GroceryItem>): AisleGroup[] {
  let open = items.filter((i) => !i.done).sort(byCreated);

  return AISLES
    .map((a) => ({ id: a.key, key: a.key, label: a.label, items: open.filter((i) => i.aisle === a.key) }))
    .filter((g) => g.items.length > 0);
}

function inCart(items: LiveView<GroceryItem>): GroceryItem[] {
  return items.filter((i) => i.done).sort((a, b) => a.name.localeCompare(b.name));
}

function onAdd(items: LiveView<GroceryItem>, draft: Draft) {
  let name = draft.name.trim();

  if (!name) {
    return;
  }

  items.insert(
    {
      name,
      quantity: draft.quantity.trim(),
      aisle: draft.aisle || guessAisle(name),
      done: false,
      addedBy: session.get("userName") ?? "",
      createdAt: new Date(),
    },
    () => {
      draft.name = "";
      draft.quantity = "";
      draft.aisle = "";
    },
  );
}

function onToggle(items: LiveView<GroceryItem>, item: GroceryItem) {
  items.update({ ...item, done: !item.done });
}

function onRemove(items: LiveView<GroceryItem>, item: GroceryItem) {
  items.delete(item);
}

function onClearCart(items: LiveView<GroceryItem>) {
  for (let item of items.filter((i) => i.done)) {
    items.delete(item);
  }
}

function onCreateList(lists: LiveView<GroceryList>, form: NewList) {
  let name = form.name.trim();

  if (!name) {
    return;
  }

  let list = lists.insert({ name, createdAt: new Date() }, () => {
    form.name = "";
    form.open = false;
  });

  redirect(`/lists/${list.id}`);
}

function onDeleteList(lists: LiveView<GroceryList>, list: GroceryList) {
  lists.delete(list);
  redirect("/lists");
}

<html lang="en" class="page-lists" (
  householdName: string,
  color: string,
  lists: LiveView<GroceryList>,
  listId: string,
  items: LiveView<GroceryItem>,
  private draft: Draft = { quantity: "", name: "", aisle: "" },
  private newList: NewList = { open: false, name: "" },
)>
  <head>
    <title>{lists.get(listId)?.name ?? "Groceries"} · kinroster</title>
  </head>
  <body>
    <Layout active="lists" {householdName} {color}>
      <div class="page-shell is-form stack is-lg">
        <div class="stack is-sm">
          <nav class="lists-tabs row" aria-label="Grocery lists">
            <a e:for={list of lists.sort(byCreated)}
               href={`/lists/${list.id}`}
               class={["lists-tab", list.id === listId && "is-active"]}>{list.name}</a>

            <form e:if={newList.open}
                  class="lists-newlist row"
                  onsubmit={() => onCreateList(lists, newList)}>
              <Input size="sm" value={newList.name} placeholder="List name" required autoFocus attrs={{ "aria-label": "New list name" }} />
              <Button size="sm" variant="primary" type="submit">Create</Button>
              <Button size="sm" variant="ghost" onclick={() => newList.open = false}>Cancel</Button>
            </form>
            <Button e:else size="sm" variant="ghost" onclick={() => newList.open = true}>+ New list</Button>
          </nav>

          <div class="lists-head row">
            <h1>{lists.get(listId)?.name}</h1>
            <AlertDialog e:if={lists.length > 1}
                         title={`Delete "${lists.get(listId)?.name}" and everything on it?`}
                         size="sm">
              <Button slot="trigger" size="sm" variant="ghost">Delete list</Button>
              <AlertDialogFooter>
                <AlertDialogCancel>Cancel</AlertDialogCancel>
                <AlertDialogAction variant="danger" onclick={() => onDeleteList(lists, lists.get(listId)!)}>Delete</AlertDialogAction>
              </AlertDialogFooter>
            </AlertDialog>
          </div>

          <div class="lists-progress row" e:if={items.length > 0}>
            <span>{items.filter((i) => !i.done).length} to get</span>
            <Progress class="lists-progress-bar"
                      size="sm"
                      max={items.length}
                      value={items.filter((i) => i.done).length}
                      attrs={{ "aria-label": "In the cart" }} />
            <span>{items.filter((i) => i.done).length} in the cart</span>
          </div>
        </div>

        <form class="lists-add" onsubmit={() => onAdd(items, draft)}>
          <Input class="lists-add-qty" value={draft.quantity} placeholder="Qty" attrs={{ "aria-label": "Quantity" }} />
          <Input class="lists-add-name" value={draft.name} placeholder="Add an item…" required attrs={{ "aria-label": "Item", autocomplete: "off" }} />
          <NativeSelect class="lists-add-aisle" block value={draft.aisle} attrs={{ "aria-label": "Aisle" }}>
            <option value="">Auto · {aisleLabel(guessAisle(draft.name))}</option>
            <option e:for={a of AISLES} value={a.key}>{a.label}</option>
          </NativeSelect>
          <Button class="lists-add-submit" variant="primary" type="submit">Add</Button>
        </form>

        <Empty e:if={items.length === 0}
               class="card"
               title="Nothing on this list yet."
               description="Add what you need above, or send a dinner's ingredients here from the meal plan." />

        <section e:for={group of toGet(items)} class="aisle card">
          <div class="aisle-head row">
            <h2>{group.label}</h2>
            <span class="aisle-count">{group.items.length}</span>
          </div>
          <ul class="items">
            <ItemRow e:for={item of group.items} {items} {item} />
          </ul>
        </section>

        <section class="aisle cart card" e:if={inCart(items).length > 0}>
          <div class="aisle-head row">
            <h2>In the cart · {inCart(items).length}</h2>
            <Button size="sm" variant="ghost" onclick={() => onClearCart(items)}>Clear</Button>
          </div>
          <ul class="items">
            <ItemRow e:for={item of inCart(items)} {items} {item} />
          </ul>
        </section>
      </div>
    </Layout>
  </body>
</html>

<ItemRow (items: LiveView<GroceryItem>, item: GroceryItem)>
  <li class={["item", item.done && "is-done"]}>
    <Label class="item-check">
      <Checkbox class="item-box" checked={item.done} onCheckedChange={() => onToggle(items, item)} />
      <span class="item-name">
        <span class="item-title">{item.name}</span>
        <small e:if={item.addedBy}>{firstName(item.addedBy)}</small>
      </span>
      <Badge e:if={item.quantity} variant="secondary" class="item-qty">{item.quantity}</Badge>
    </Label>
    <Button class="item-remove" variant="ghost" size="sm" icon label={`Remove ${item.name}`} onclick={() => onRemove(items, item)}>
      <Icon name="x" />
    </Button>
  </li>
</ItemRow>
